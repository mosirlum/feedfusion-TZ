# Copy to .env for dev, and to .env.test for a SEPARATE test database.
PORT=4000

# Paste your Neon connection strings here (you already have these from the
# Auth module setup — same values, this is the same database, just a fresh
# copy of the application code).
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
